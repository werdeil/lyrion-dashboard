# Lyrion Music Server
LYRION_HOST=https://lyrion.local:9000

# Lyrion's data directory, the one holding its prefs/ and cache/ subdirectories
# (/config for the Docker image, /var/lib/squeezeboxserver for the Debian
# package). library.db and persist.db are derived from it, and Compose mounts
# it read-only.
LYRION_DATA_DIR=/path/to/squeezeboxserver

# Custom data
CUSTOM_DATA_DIR=/opt/scripts/custom_data

# Optional: timezone used to align the listening-velocity windows on local
# midnight (default UTC). Example: TZ=Europe/Paris
# TZ=Europe/Paris

# Lyrics: web providers tried in order, the first one that responds wins.
# Possible values: lrclib, musixmatch, genius
LYRICS_PROVIDERS=lrclib,musixmatch,genius
# Optional: fixed Musixmatch token (otherwise fetched automatically)
# MUSIXMATCH_TOKEN=
# Optional: LRCLIB request timeout in seconds (default 15). Raise it on evenings
# when LRCLIB is slow under load and fetches start timing out.
# LRCLIB_TIMEOUT=15
# Optional: max drift (seconds) between a provider's reported track length and
# the file's own duration before a --verify match is rejected (default 3).
# Only used by scripts/embed_lyrics.py.
# LYRICS_VERIFY_DURATION_TOLERANCE=3

# Logging: verbosity of the application logs, visible with
# `docker logs -f lyrion-dashboard`. INFO keeps one line per lyrics search and
# per slow query; DEBUG adds the per-provider and per-query detail useful when
# a track shows no lyrics. Values: DEBUG, INFO, WARNING, ERROR, CRITICAL.
# LOG_LEVEL=INFO

# Development: set DEV=1 to live-reload templates and disable static caching,
# so HTML/CSS edits show up on a page refresh without restarting the server.
# DEV=1
