# Fichier d'exemple pour les personnalisations Docker Compose locales.
# Copiez ce fichier en docker-compose.override.yml et adaptez-le.
# Ce fichier est ignoré par Git via .gitignore.

services:
  lyrion-dashboard:
    # Construire depuis les sources de ce dépôt au lieu de tirer l'image
    # publiée : `docker compose up -d --build`.
    build: .
    volumes:
      - .:/app:ro
    environment:
      - DEV=1
      - LOG_LEVEL=DEBUG

    # Si les fichiers de Lyrion ne sont pas lisibles par l'uid 1000 de l'image,
    # lancer le conteneur sous l'utilisateur qui les possède.
    # user: "0:0"

# Exemple d'ajout de service auxiliaire : Redis
# services:
#   redis:
#     image: redis:latest
#     ports:
#       - "6379:6379"
